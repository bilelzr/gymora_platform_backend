<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      GYMORA platform backend: one Spring Boot application built from separate Maven modules.
        platform/  shared foundation every business module relies on (tenancy, security, access, ...)
        modules/   business modules (membership, payments, attendance, ...)
        gymora-app the runnable application that assembles all modules
      To add a business module: create modules/gymora-<name>, list it below, and add it as a
      dependency of gymora-app. See README.md.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.gymora</groupId>
    <artifactId>gymora-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>GYMORA :: Parent</name>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>3.2.0</springdoc.version>
    </properties>

    <modules>
        <module>platform/gymora-common</module>
        <module>platform/gymora-security</module>
        <module>platform/gymora-tenant</module>
        <module>platform/gymora-access</module>
        <module>modules/gymora-membership</module>
        <module>modules/gymora-subscription</module>
        <module>gymora-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.gymora</groupId>
                <artifactId>gymora-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gymora</groupId>
                <artifactId>gymora-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gymora</groupId>
                <artifactId>gymora-tenant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gymora</groupId>
                <artifactId>gymora-access</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gymora</groupId>
                <artifactId>gymora-membership</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gymora</groupId>
                <artifactId>gymora-subscription</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- On Windows, Java NIO opens a Unix-domain socket in the temp folder; some
                             restricted environments block that ("Unable to establish loopback connection"). -->
                        <argLine>-Djdk.net.unixdomain.tmpdir=${project.build.directory}</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencies>
        <!-- Shared test stack for every module -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
